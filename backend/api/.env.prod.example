# 운영(prod 프로필)용. 복사해서 .env.prod로 만들고 값을 채운다. 커밋하지 않는다.
# 배포 환경에서 환경 변수로 직접 넣어도 된다(환경 변수가 이 파일보다 우선한다).
# .properties 형식으로 읽으므로 값을 따옴표로 감싸지 않는다(따옴표까지 값이 된다).
DB_URL=jdbc:postgresql://{호스트}:5432/threem_api
DB_USERNAME=
DB_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상
JWT_SECRET=
FRONTEND_URL=
